# Shared backend search key. Public users never see it.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1

# Optional photo verification. If empty, photo-only features remain candidate.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_DETAIL=high
OPENAI_VISION_MAX_IMAGES=4
OPENAI_VISION_MIN_CONFIDENCE=0.85

# Optional notifications
TELEGRAM_BOT_TOKEN=

# Public deployment. Use a real domain (for example cars.example.com) for automatic HTTPS.
# Keep http://localhost for local/VPS-IP testing without a domain.
PUBLIC_HOST=http://localhost
PUBLIC_RATE_LIMIT_PER_MINUTE=60
CREATE_SEARCH_LIMIT_PER_HOUR=12
